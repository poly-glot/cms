{
  "name": "cakephp/app",
  "description": "CakePHP skeleton app",
  "license": "MIT",
  "type": "project",
  "homepage": "https://cakephp.org",
  "require": {
    "php": ">=8.4",
    "cakephp/authentication": "^3.0",
    "cakephp/authorization": "^3.0",
    "cakephp/cakephp": "5.3.*",
    "cakephp/migrations": "^5.0",
    "cakephp/plugin-installer": "^2.0",
    "ezyang/htmlpurifier": "^4.18",
    "intervention/image": "^4.1",
    "symfony/yaml": "^8.1",
    "webonyx/graphql-php": "^15"
  },
  "require-dev": {
    "cakedc/cakephp-phpstan": "^4.0",
    "cakephp/bake": "^3.6",
    "friendsofphp/php-cs-fixer": "^3.65",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^11.5.3 || ^12.1.3 || ^13.0",
    "rector/rector": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Test\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "cakephp/plugin-installer": true,
      "phpstan/extension-installer": true
    },
    "platform-check": true,
    "sort-packages": true
  },
  "scripts": {
    "post-install-cmd": "App\\Console\\Installer::postInstall",
    "cs-check": "php-cs-fixer fix --dry-run --diff",
    "cs-fix": "php-cs-fixer fix",
    "test": "phpunit",
    "phpstan": "phpstan analyse --no-progress --memory-limit=512M",
    "phpstan-baseline": "phpstan analyse --no-progress --generate-baseline",
    "rector": "rector process",
    "rector-dry": "rector process --dry-run",
    "test-coverage": "phpunit --coverage-text",
    "quality": [
      "@cs-check",
      "@phpstan",
      "@rector-dry",
      "@test"
    ]
  }
}
